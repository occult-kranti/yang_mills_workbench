    {
      "type": "single face",
      "possible_labels": [
        "left-end",
        "bridge",
        "right-end"
      ],
      "safe_free_bound": "3alpha/4 - max(alpha/2, alpha/8) >= alpha/4 for end faces and >=5alpha/8 for bridge-only"
    },
    {
      "type": "two contiguous faces",
      "possible_labels": [
        "left-end+bridge",
        "bridge+right-end"
      ],
      "safe_free_bound": "3alpha/4 - (alpha/2+alpha/8) = alpha/8"
    },
    {
      "type": "three contiguous faces",
      "possible_labels": [
        "left-end+bridge+right-end"
      ],
      "required_bound": "reuse/reprove dressed-bridge A1 bound alpha/8 with actual untouched bridge link"
    }
  ],
