  "schema": "ym19-advisor-boundary-classification-v1",
  "purpose": "preliminary exact combinatorial classification for Round19 A1 contract; not a scientific gate",
  "literal_assignment": "xy faces are locally labelled left-end, bridge, right-end by x mod 4 in {0,1,2} on even y rows; finite boxes inherit coefficients by restriction instead of waiting for complete three-face strips",
